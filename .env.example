# Same-origin when the build is served by the dashboard under /app.
# Over the SSH tunnel, point the dev server at the local forward:
#   VITE_API_BASE=http://127.0.0.1:8765
# Legacy name VITE_TRIADE_API_BASE is still read if VITE_API_BASE is unset.
VITE_API_BASE=

# Optional. The v2 server does not require a token (auth_required: false).
# Never commit a real token.
VITE_TRIADE_TOKEN=

# Vite base path. Production copy under /opt/triade/frontend/app uses /app/.
# Use VITE_BASE=/ when running `npm run dev` or `npm run preview` at the site root.
VITE_BASE=/app/
